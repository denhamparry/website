{
  "name": "denhamparry-website-tests",
  "version": "1.0.0",
  "description": "Testing suite for denhamparry.co.uk Hugo website",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:hugo && npm run test:functional && npm run test:accessibility",
    "test:hugo": "node tests/hugo/test-hugo-build.js",
    "test:functional": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/functional",
    "test:accessibility": "node tests/accessibility/test-accessibility.js",
    "test:links": "linkinator public --recurse --skip 'livereload.js' --skip 'googletagmanager.com' --skip 'index.json'",
    "test:spell": "cspell '**/*.md' '**/*.txt' --no-progress",
    "serve": "hugo server -D",
    "build": "hugo --gc --minify",
    "build:preview": "hugo --gc --minify --buildFuture"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "4.13.0",
    "axios": "1.19.0",
    "cspell": "10.2.0",
    "jest": "30.4.2",
    "linkinator": "8.0.4",
    "puppeteer": "25.9.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
